import java.security.MessageDigest;
import java.security.SecureRandom;
import java.util.Scanner;

public class PasswordHashing {

    // Convert byte array into hexadecimal string
    public static String toHex(byte[] data) {
        StringBuilder sb = new StringBuilder();

        for (byte b : data) {
            sb.append(String.format("%02x", b));
        }

        return sb.toString();
    }

    // SHA-256 hashing without salt
    public static String hashWithoutSalt(String password)
            throws Exception {

        MessageDigest md = MessageDigest.getInstance("SHA-256");

        byte[] hash = md.digest(password.getBytes("UTF-8"));

        return toHex(hash);
    }

    // SHA-256 hashing with random salt
    public static String hashWithSalt(String password, byte[] salt)
            throws Exception {

        MessageDigest md = MessageDigest.getInstance("SHA-256");

        md.update(salt);

        byte[] hash = md.digest(password.getBytes("UTF-8"));

        return toHex(hash);
    }

    public static void main(String[] args) throws Exception {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter password: ");
        String password = sc.nextLine();

        // Hash without salt
        String hash1 = hashWithoutSalt(password);

        // Generate random salt
        SecureRandom random = new SecureRandom();

        byte[] salt1 = new byte[16];
        byte[] salt2 = new byte[16];

        random.nextBytes(salt1);
        random.nextBytes(salt2);

        // Hash with different salts
        String hash2 = hashWithSalt(password, salt1);
        String hash3 = hashWithSalt(password, salt2);

        System.out.println("\n--- Password Hashing Results ---");

        System.out.println("Password: " + password);

        System.out.println("\nHash Without Salt:");
        System.out.println(hash1);

        System.out.println("\nSalt 1:");
        System.out.println(toHex(salt1));

        System.out.println("Hash With Salt 1:");
        System.out.println(hash2);

        System.out.println("\nSalt 2:");
        System.out.println(toHex(salt2));

        System.out.println("Hash With Salt 2:");
        System.out.println(hash3);

        System.out.println("\n--- Comparison ---");

        System.out.println("Without Salt Hashes are identical for same password.");

        System.out.println("With Different Salts, Hashes are different.");

        sc.close();
    }
}
